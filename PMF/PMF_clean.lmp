variable        temperature index 293.15
variable        randomSeed  equal 876439
variable        run_NVT1 index 5000000
variable        run_NVT2 index 5000000

units           real
dimension       3
boundary        p p p

atom_style      full
bond_style      harmonic

read_data       modified_C3_synapsin.dat
include         C3_mixed_slim_par.dat

# group of both proteins
group           particle1 id <> 113 420
group           particle2 id <> 819 1126
group           proteina1 id <> 1 705
group           proteina2 id <> 706 1410

# Parameters
neighbor        3.5 multi
neigh_modify    every 20 delay 20 check yes

special_bonds   fene

# Energy minimization
min_style       fire
timestep        0.0000001
minimize        0.0 1.0e-8 1000 100000
timestep        0.00001
minimize        0.0 1.0e-8 1000 100000
timestep        0.1
minimize        0.0 1.0e-8 1000 100000
timestep        10
minimize        0.0 1.0e-8 1000 10000

# Inicialization
timestep        10
reset_timestep  0
velocity        all create ${temperature} ${randomSeed}

# Dinamic 
fix             fxnve   all     nve
fix             fxlange all     langevin ${temperature} ${temperature} 10000.0 ${randomSeed}
fix             fxcom   all     recenter 0 0 0

thermo          10000
thermo_style    custom step pe ecoul ke temp press lx ly lz xlo xhi ylo yhi zlo zhi
run             ${run_NVT1}



# Center of mass
compute         com1 particle1 com
compute         com2 particle2 com
compute         p1p2 proteina1 pe/mol/tally proteina2

run             0      

reset_timestep  0

# Correction of center of mass
variable        COM1_x equal "c_com1[1] - floor((c_com1[1] - xlo)/lx) * lx"
variable        COM1_y equal "c_com1[2] - floor((c_com1[2] - ylo)/ly) * ly"
variable        COM1_z equal "c_com1[3] - floor((c_com1[3] - zlo)/lz) * lz"
variable        COM2_x equal "c_com2[1] - floor((c_com2[1] - xlo)/lx) * lx"
variable        COM2_y equal "c_com2[2] - floor((c_com2[2] - ylo)/ly) * ly"
variable        COM2_z equal "c_com2[3] - floor((c_com2[3] - zlo)/lz) * lz"

# variables definitions
variable         p1p2_1 equal "c_p1p2[1]"
variable         p1p2_2 equal "c_p1p2[2]"
variable         p1p2_3 equal "c_p1p2[3]"
variable         p1p2_4 equal "c_p1p2[4]"


# Distances of center of mass
variable        dist_x_c equal v_COM1_x-v_COM2_x # Diferença no eixo x
variable        dist_y_c equal v_COM1_y-v_COM2_y  # Diferença no eixo y
variable        dist_z_c equal v_COM1_z-v_COM2_z  # Diferença no eixo z

# Correction of PBC
variable        dist_x_pbc equal "v_dist_x_c - round(v_dist_x_c/lx)*lx"
variable        dist_y_pbc equal "v_dist_y_c - round(v_dist_y_c/ly)*ly"
variable        dist_z_pbc equal "v_dist_z_c - round(v_dist_z_c/lz)*lz"

# Total distance between center of mass
variable        reactionCoord_c equal "sqrt(v_dist_x_pbc^2 + v_dist_y_pbc^2 + v_dist_z_pbc^2)"

dump            trajectory all custom 100000 dump_full_T_${temperature}.lammpstrj mol id type mass x y z


# Values list for reaction coordenate of umbrella sampling
variable        z0_values file z0_values.txt
variable        k equal 2.                   # Constante de força para a restrição

label           loop

variable        z0 equal ${z0_values}


# Restoring force 
fix             umbrella_force particle1 spring couple particle2 ${k} 0.0 0.0 0.0 ${z0}

run             ${run_NVT2} #equilibrate

fix             myat1 all ave/time 10 10 1000 v_reactionCoord_c v_z0 file position.${z0_values}.dat
fix             energies_ec_evdw all ave/time 1 ${run_NVT2} ${run_NVT2} c_p1p2[3] c_p1p2[4] v_reactionCoord_c file RC_energies_z0_${z0_values}.dat

# Simulation run and next values

run             ${run_NVT2}

unfix           myat1
unfix           energies_ec_evdw


next            z0_values
jump            SELF loop
